rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Password-authenticated vendor accounts created via Admin Concierge Store Claim
    function isPasswordUser() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isAuthenticatedUser() {
      return isVerifiedUser() || isPasswordUser();
    }

    function isOwner(uid) {
      return isAuthenticatedUser() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSha256Id(id) {
      return id is string && id.size() == 64 && id.matches('^[a-f0-9]{64}$');
    }

    // Root admin token check (no DB lookup, strictly enforces email_verified == true to prevent spoofing)
    function isRootAdminToken() {
      return isVerifiedUser() && request.auth.token.email == 'crosscraftedin@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'crosscraftedin@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Blueprints ---
    function isValidStringList(listVal, maxLen, maxItemLen) {
      return listVal is list &&
        listVal.size() <= maxLen &&
        (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= maxItemLen));
    }

    function isValidNonEmptyStringList(listVal, maxLen, maxItemLen) {
      return listVal is list &&
        listVal.size() >= 1 &&
        listVal.size() <= maxLen &&
        listVal[0] is string &&
        listVal[0].size() >= 1 &&
        listVal[0].size() <= maxItemLen;
    }

    function isValidProductsList(listVal) {
      return listVal is list &&
        listVal.size() <= 30 &&
        (listVal.size() == 0 || listVal[0] is map);
    }

    function isValidCustomLinksList(listVal) {
      return listVal is list &&
        listVal.size() <= 8 &&
        (listVal.size() == 0 || listVal[0] is map);
    }

    function isValidVendor(data) {
      return data.keys().hasAll([
          'ownerId', 'slug', 'name', 'marketplace', 'category',
          'country', 'city', 'whatsappNumber', 'planTier',
          'verified', 'status', 'image', 'products', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'slug', 'name', 'marketplace', 'category',
          'country', 'state', 'city', 'area', 'lat', 'lng',
          'whatsappNumber', 'planTier', 'monthlyAutoPay', 'priceTier',
          'startingPriceUsd', 'rating', 'reviewCount', 'responseTime',
          'verified', 'status', 'tagline', 'description', 'promoBanner',
          'christmasSpecial', 'christmasOffer',
          'bioHandle', 'bioTheme', 'instagramHandle', 'customLinks',
          'serviceAreas', 'allStatesCoverage', 'serviceStates',
          'specialties', 'image', 'logo', 'gallery', 'products',
          'claimStatus', 'claimedByToken',
          'seoTitle', 'seoDescription', 'seoKeywords',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100 && data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.marketplace in ['food', 'party'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.country in ['India', 'Dubai / UAE', 'Sri Lanka', 'Pakistan', 'Bangladesh', 'Nepal'] &&
        (!('state' in data) || (data.state is string && data.state.size() <= 80)) &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
        (!('area' in data) || (data.area is string && data.area.size() <= 100)) &&
        (!('lat' in data) || (data.lat is number && data.lat >= -90 && data.lat <= 90)) &&
        (!('lng' in data) || (data.lng is number && data.lng >= -180 && data.lng <= 180)) &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 7 && data.whatsappNumber.size() <= 22 && data.whatsappNumber.matches('^[0-9+\\-\\s()]+$') &&
        data.planTier in ['free', 'pro', 'business'] &&
        (!('monthlyAutoPay' in data) || data.monthlyAutoPay is bool) &&
        (!('priceTier' in data) || data.priceTier in ['$', '$$', '$$$', '$$$$']) &&
        (!('startingPriceUsd' in data) || (data.startingPriceUsd is number && data.startingPriceUsd >= 0 && data.startingPriceUsd <= 100000)) &&
        (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
        (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0 && data.reviewCount <= 100000)) &&
        (!('responseTime' in data) || (data.responseTime is string && data.responseTime.size() <= 80)) &&
        data.verified is bool &&
        data.status in ['active', 'pending_review', 'paused'] &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1500)) &&
        (!('promoBanner' in data) || (data.promoBanner is string && data.promoBanner.size() <= 140)) &&
        (!('christmasSpecial' in data) || data.christmasSpecial is bool) &&
        (!('christmasOffer' in data) || (data.christmasOffer is string && data.christmasOffer.size() <= 160)) &&
        (!('bioHandle' in data) || (data.bioHandle is string && data.bioHandle.size() <= 60 && (data.bioHandle == '' || data.bioHandle.matches('^[a-z0-9_\\-]+$')))) &&
        (!('bioTheme' in data) || data.bioTheme in ['saffron', 'midnight', 'party', 'cream']) &&
        (!('instagramHandle' in data) || (data.instagramHandle is string && data.instagramHandle.size() <= 80)) &&
        (!('customLinks' in data) || isValidCustomLinksList(data.customLinks)) &&
        (!('claimStatus' in data) || data.claimStatus in ['none', 'pending', 'claimed']) &&
        (!('claimedByToken' in data) || data.claimedByToken == '' || isValidSha256Id(data.claimedByToken)) &&
        (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 120)) &&
        (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 240)) &&
        (!('seoKeywords' in data) || (data.seoKeywords is string && data.seoKeywords.size() <= 300)) &&
        (!('serviceAreas' in data) || isValidStringList(data.serviceAreas, 10, 100)) &&
        (!('allStatesCoverage' in data) || data.allStatesCoverage is bool) &&
        (!('serviceStates' in data) || isValidStringList(data.serviceStates, 40, 80)) &&
        (!('specialties' in data) || isValidStringList(data.specialties, 10, 100)) &&
        data.image is string && data.image.size() >= 1 && data.image.size() <= 350000 &&
        (!('logo' in data) || (data.logo is string && data.logo.size() <= 120000)) &&
        (!('gallery' in data) || isValidStringList(data.gallery, 6, 200000)) &&
        isValidProductsList(data.products) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'savedVendorIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'savedVendorIds', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        isValidStringList(data.savedVendorIds, 50, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'reference', 'customerId', 'vendorId', 'vendorOwnerId',
          'vendorName', 'vendorCity', 'vendorCategory', 'packageName',
          'estimatedUsd', 'eventDate', 'guests', 'customerName',
          'customerEmail', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'reference', 'customerId', 'vendorId', 'vendorOwnerId',
          'vendorName', 'vendorCity', 'vendorCategory', 'packageName',
          'estimatedUsd', 'eventDate', 'guests', 'customerName',
          'customerEmail', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.reference is string && data.reference.size() >= 4 && data.reference.size() <= 32 && data.reference.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.customerId) &&
        isValidId(data.vendorId) &&
        isValidId(data.vendorOwnerId) &&
        data.vendorName is string && data.vendorName.size() >= 1 && data.vendorName.size() <= 120 &&
        data.vendorCity is string && data.vendorCity.size() >= 1 && data.vendorCity.size() <= 120 &&
        data.vendorCategory is string && data.vendorCategory.size() >= 1 && data.vendorCategory.size() <= 80 &&
        data.packageName is string && data.packageName.size() >= 1 && data.packageName.size() <= 240 &&
        data.estimatedUsd is number && data.estimatedUsd >= 0 && data.estimatedUsd <= 500000 &&
        data.eventDate is string && data.eventDate.size() >= 6 && data.eventDate.size() <= 30 &&
        data.guests is number && data.guests >= 1 && data.guests <= 100000 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160 &&
        data.notes is string && data.notes.size() <= 1000 &&
        data.status in ['Confirmed Enquiry', 'Awaiting Vendor Reply', 'Completed', 'Cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'vendorId', 'authorId', 'authorName', 'eventType',
          'rating', 'comment', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'vendorId', 'authorId', 'authorName', 'eventType',
          'rating', 'comment', 'createdAt'
        ]) &&
        isValidId(data.vendorId) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.eventType is string && data.eventType.size() >= 2 && data.eventType.size() <= 60 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 600 &&
        data.createdAt is timestamp;
    }

    function isValidEventRequest(data) {
      return data.keys().hasAll([
          'customerId', 'customerName', 'occasion', 'categories',
          'country', 'state', 'city', 'eventDate', 'guests',
          'budgetUsd', 'details', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'customerId', 'customerName', 'occasion', 'categories',
          'country', 'state', 'city', 'eventDate', 'guests',
          'budgetUsd', 'details', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.customerId) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
        data.occasion is string && data.occasion.size() >= 2 && data.occasion.size() <= 60 &&
        isValidNonEmptyStringList(data.categories, 4, 80) &&
        data.country in ['India', 'Dubai / UAE', 'Sri Lanka', 'Pakistan', 'Bangladesh', 'Nepal'] &&
        data.state is string && data.state.size() >= 2 && data.state.size() <= 80 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
        data.eventDate is string && data.eventDate.size() >= 6 && data.eventDate.size() <= 30 &&
        data.guests is number && data.guests >= 1 && data.guests <= 100000 &&
        data.budgetUsd is number && data.budgetUsd >= 0 && data.budgetUsd <= 500000 &&
        data.details is string && data.details.size() >= 5 && data.details.size() <= 800 &&
        data.status in ['open', 'closed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEventQuote(data, requestId) {
      return data.keys().hasAll([
          'requestId', 'requestCustomerId', 'vendorOwnerId', 'vendorId', 'vendorName',
          'vendorSlug', 'vendorWhatsapp', 'priceUsd', 'message', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'requestId', 'requestCustomerId', 'vendorOwnerId', 'vendorId', 'vendorName',
          'vendorSlug', 'vendorWhatsapp', 'priceUsd', 'message', 'createdAt'
        ]) &&
        data.requestId == requestId &&
        isValidId(data.requestId) &&
        isValidId(data.requestCustomerId) &&
        isValidId(data.vendorOwnerId) &&
        isValidId(data.vendorId) &&
        data.vendorName is string && data.vendorName.size() >= 2 && data.vendorName.size() <= 100 &&
        data.vendorSlug is string && data.vendorSlug.size() >= 2 && data.vendorSlug.size() <= 100 && data.vendorSlug.matches('^[a-z0-9\\-]+$') &&
        data.vendorWhatsapp is string && data.vendorWhatsapp.size() >= 7 && data.vendorWhatsapp.size() <= 18 && data.vendorWhatsapp.matches('^[0-9]+$') &&
        data.priceUsd is number && data.priceUsd >= 1 && data.priceUsd <= 500000 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 600 &&
        data.createdAt is timestamp;
    }

    function isValidVendorMetric(data, vendorId) {
      return data.keys().hasAll(['vendorId', 'views', 'whatsappClicks', 'shares', 'updatedAt']) &&
        data.keys().hasOnly(['vendorId', 'views', 'whatsappClicks', 'shares', 'updatedAt']) &&
        data.vendorId == vendorId &&
        isValidId(data.vendorId) &&
        data.views is number && data.views >= 0 && data.views <= 100000000 &&
        data.whatsappClicks is number && data.whatsappClicks >= 0 && data.whatsappClicks <= 100000000 &&
        data.shares is number && data.shares >= 0 && data.shares <= 100000000 &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['uid', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'grantedAt']) &&
        data.uid == adminId &&
        isValidId(data.uid) &&
        data.grantedAt is timestamp;
    }

    function isValidStoreClaim(data) {
      return data.keys().hasAll([
          'vendorId', 'vendorSlug', 'vendorName', 'phoneLast4',
          'status', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'vendorId', 'vendorSlug', 'vendorName', 'phoneLast4',
          'status', 'createdBy', 'claimedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.vendorId) &&
        data.vendorSlug is string && data.vendorSlug.size() >= 2 && data.vendorSlug.size() <= 100 && data.vendorSlug.matches('^[a-z0-9\\-]+$') &&
        data.vendorName is string && data.vendorName.size() >= 2 && data.vendorName.size() <= 100 &&
        data.phoneLast4 is string && data.phoneLast4.size() == 4 && data.phoneLast4.matches('^[0-9]{4}$') &&
        data.status in ['pending', 'claimed', 'revoked'] &&
        isValidId(data.createdBy) &&
        (!('claimedBy' in data) || isValidId(data.claimedBy)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminTransfer(data, vendorId) {
      return data.keys().hasAll([
          'vendorId', 'vendorName', 'vendorSlug', 'targetPhone',
          'passcode', 'claimId', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'vendorId', 'vendorName', 'vendorSlug', 'targetPhone',
          'passcode', 'claimId', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.vendorId == vendorId &&
        isValidId(data.vendorId) &&
        data.vendorName is string && data.vendorName.size() >= 2 && data.vendorName.size() <= 100 &&
        data.vendorSlug is string && data.vendorSlug.size() >= 2 && data.vendorSlug.size() <= 100 && data.vendorSlug.matches('^[a-z0-9\\-]+$') &&
        data.targetPhone is string && data.targetPhone.size() >= 7 && data.targetPhone.size() <= 18 && data.targetPhone.matches('^[0-9]+$') &&
        data.passcode is string && data.passcode.size() >= 6 && data.passcode.size() <= 24 && data.passcode.matches('^[A-Z0-9\\-]+$') &&
        isValidSha256Id(data.claimId) &&
        data.status in ['pending', 'claimed', 'revoked'] &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
          'siteTitle', 'siteDescription', 'siteKeywords',
          'promoEnabled', 'promoText', 'promoCtaLabel',
          'snowfallEnabled', 'requireVendorApproval',
          'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'siteTitle', 'siteDescription', 'siteKeywords',
          'promoEnabled', 'promoText', 'promoCtaLabel',
          'snowfallEnabled', 'requireVendorApproval',
          'updatedBy', 'updatedAt'
        ]) &&
        data.siteTitle is string && data.siteTitle.size() >= 5 && data.siteTitle.size() <= 120 &&
        data.siteDescription is string && data.siteDescription.size() >= 10 && data.siteDescription.size() <= 240 &&
        data.siteKeywords is string && data.siteKeywords.size() <= 400 &&
        data.promoEnabled is bool &&
        data.promoText is string && data.promoText.size() <= 200 &&
        data.promoCtaLabel is string && data.promoCtaLabel.size() <= 60 &&
        data.snowfallEnabled is bool &&
        data.requireVendorApproval is bool &&
        isValidId(data.updatedBy) &&
        data.updatedAt is timestamp;
    }

    function isValidChristmasDish(data) {
      return data.keys().hasAll([
          'name', 'category', 'foodType', 'priceInrPerGuest',
          'portion', 'description', 'popular', 'active',
          'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'category', 'foodType', 'priceInrPerGuest',
          'portion', 'description', 'image', 'popular', 'presets', 'active',
          'sortOrder', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.category in [
          'christmas-specials', 'starters', 'biryani-rice', 'curries-dal',
          'breads', 'soups-chinese', 'desserts', 'beverages-sides'
        ] &&
        data.foodType in ['veg', 'non-veg'] &&
        data.priceInrPerGuest is number && data.priceInrPerGuest >= 1 && data.priceInrPerGuest <= 50000 &&
        data.portion is string && data.portion.size() >= 1 && data.portion.size() <= 60 &&
        data.description is string && data.description.size() <= 400 &&
        (!('image' in data) || (data.image is string && data.image.size() <= 150000)) &&
        data.popular is bool &&
        (!('presets' in data) || (
          data.presets is list &&
          data.presets.size() <= 3 &&
          data.presets.hasOnly(['christmas-veg', 'christmas-non-veg', 'cocktail-snacks'])
        )) &&
        data.active is bool &&
        (!('sortOrder' in data) || (data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000)) &&
        isValidId(data.updatedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection: /vendors/{vendorId} ---
    match /vendors/{vendorId} {
      allow get: if isValidId(vendorId) && (
        existing().status == 'active' ||
        isOwner(existing().ownerId) ||
        isAdmin()
      );

      allow list: if existing().status == 'active' ||
        (isAuthenticatedUser() && existing().ownerId == request.auth.uid) ||
        isRootAdminToken();

      allow create: if isAuthenticatedUser() &&
        isValidId(vendorId) &&
        isValidVendor(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        !('claimedByToken' in incoming()) &&
        (!('claimStatus' in incoming()) || incoming().claimStatus == 'none' || (incoming().claimStatus == 'pending' && isAdmin())) &&
        (!('allStatesCoverage' in incoming()) || incoming().allStatesCoverage == false || isAdmin()) &&
        (!('serviceStates' in incoming()) || incoming().serviceStates.size() == 0 || isAdmin()) &&
        incoming().status in ['active', 'pending_review'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        ((incoming().verified == false && (!('reviewCount' in incoming()) || incoming().reviewCount == 0)) || isAdmin());

      allow update: if isAuthenticatedUser() &&
        isValidId(vendorId) &&
        isValidVendor(incoming()) &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time && (
          // Tier 1: Owner editing storefront details (cannot self-approve pending_review)
          (
            incoming().ownerId == existing().ownerId &&
            isOwner(existing().ownerId) &&
            incoming().verified == existing().verified &&
            (!('rating' in existing()) || incoming().rating == existing().rating) &&
            (!('reviewCount' in existing()) || incoming().reviewCount == existing().reviewCount) &&
            (
              (existing().status != 'pending_review' && incoming().status in ['active', 'paused']) ||
              incoming().status == existing().status
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'slug', 'name', 'category', 'country', 'state', 'city', 'area',
              'lat', 'lng', 'whatsappNumber', 'planTier', 'monthlyAutoPay',
              'priceTier', 'startingPriceUsd', 'responseTime', 'status',
              'tagline', 'description', 'promoBanner', 'christmasSpecial',
              'christmasOffer', 'bioHandle', 'bioTheme',
              'instagramHandle', 'customLinks', 'serviceAreas',
              'specialties', 'image', 'logo', 'gallery', 'products', 'updatedAt'
            ])
          ) ||
          // Tier 2: Admin approval, verification, SEO overrides, Christmas promotion & concierge setup
          (
            incoming().ownerId == existing().ownerId &&
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'slug', 'name', 'category', 'country', 'state', 'city', 'area',
              'lat', 'lng', 'whatsappNumber', 'verified', 'status',
              'planTier', 'monthlyAutoPay', 'priceTier', 'startingPriceUsd',
              'responseTime', 'tagline', 'description', 'promoBanner',
              'christmasSpecial', 'christmasOffer', 'bioHandle', 'bioTheme',
              'instagramHandle', 'customLinks', 'serviceAreas',
              'allStatesCoverage', 'serviceStates', 'specialties',
              'image', 'logo', 'gallery', 'products', 'claimStatus',
              'seoTitle', 'seoDescription', 'seoKeywords', 'updatedAt'
            ])
          ) ||
          // Tier 3: Atomic Baker Store Claim Transfer using a valid SHA-256 /storeClaims/{claimId} ticket
          (
            existing().claimStatus == 'pending' &&
            incoming().ownerId == request.auth.uid &&
            incoming().claimStatus == 'claimed' &&
            isValidSha256Id(incoming().claimedByToken) &&
            incoming().verified == existing().verified &&
            (!('rating' in existing()) || incoming().rating == existing().rating) &&
            (!('reviewCount' in existing()) || incoming().reviewCount == existing().reviewCount) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerId', 'claimStatus', 'claimedByToken', 'updatedAt'
            ]) &&
            get(/databases/$(database)/documents/storeClaims/$(incoming().claimedByToken)).data.status == 'pending' &&
            get(/databases/$(database)/documents/storeClaims/$(incoming().claimedByToken)).data.vendorId == vendorId &&
            getAfter(/databases/$(database)/documents/storeClaims/$(incoming().claimedByToken)).data.status == 'claimed' &&
            getAfter(/databases/$(database)/documents/storeClaims/$(incoming().claimedByToken)).data.claimedBy == request.auth.uid
          )
        );

      allow delete: if isAuthenticatedUser() &&
        isValidId(vendorId) &&
        (isOwner(existing().ownerId) || isAdmin());
    }

    // --- Collection: /storeClaims/{claimId} (Zero-PII Cryptographic Store Handover Tickets) ---
    match /storeClaims/{claimId} {
      allow get: if isValidSha256Id(claimId);
      allow list: if isRootAdminToken() || (isVerifiedUser() && existing().createdBy == request.auth.uid);

      allow create: if isAdmin() &&
        isValidSha256Id(claimId) &&
        isValidStoreClaim(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().status == 'pending' &&
        !('claimedBy' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/vendors/$(incoming().vendorId));

      allow update: if isAuthenticatedUser() &&
        isValidSha256Id(claimId) &&
        isValidStoreClaim(incoming()) &&
        incoming().vendorId == existing().vendorId &&
        incoming().vendorSlug == existing().vendorSlug &&
        incoming().vendorName == existing().vendorName &&
        incoming().phoneLast4 == existing().phoneLast4 &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Baker redeems pending ticket atomically with /vendors/{vendorId} ownership transfer
          (
            existing().status == 'pending' &&
            incoming().status == 'claimed' &&
            incoming().claimedBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedBy', 'updatedAt']) &&
            getAfter(/databases/$(database)/documents/vendors/$(existing().vendorId)).data.ownerId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/vendors/$(existing().vendorId)).data.claimStatus == 'claimed' &&
            getAfter(/databases/$(database)/documents/vendors/$(existing().vendorId)).data.claimedByToken == claimId
          ) ||
          // Action 2: Admin revokes a pending ticket (terminal)
          (
            isAdmin() &&
            existing().status == 'pending' &&
            incoming().status == 'revoked' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidSha256Id(claimId);
    }

    // --- Collection: /adminTransfers/{vendorId} (Admin-Only Handover Log with Phone & Passcode) ---
    match /adminTransfers/{vendorId} {
      allow get: if isAdmin() && isValidId(vendorId);
      allow list: if isRootAdminToken() || (isVerifiedUser() && existing().createdBy == request.auth.uid);

      allow create: if isAdmin() &&
        isValidId(vendorId) &&
        isValidAdminTransfer(incoming(), vendorId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(vendorId) &&
        isValidAdminTransfer(incoming(), vendorId) &&
        incoming().vendorId == existing().vendorId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'vendorName', 'vendorSlug', 'targetPhone', 'passcode', 'claimId', 'status', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(vendorId);
    }

    // --- Collection: /siteSettings/{settingId} (Global SEO, Campaigns & Approval Controls) ---
    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(settingId) &&
        isValidSiteSettings(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(settingId) &&
        isValidSiteSettings(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'siteTitle', 'siteDescription', 'siteKeywords',
          'promoEnabled', 'promoText', 'promoCtaLabel',
          'snowfallEnabled', 'requireVendorApproval',
          'updatedBy', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(settingId);
    }

    // --- Collection: /christmasDishes/{dishId} (Admin-Managed Hyderabad Christmas Custom Menu) ---
    match /christmasDishes/{dishId} {
      allow get: if isValidId(dishId);
      allow list: if isRootAdminToken() || (request.query.limit != null && request.query.limit <= 200);

      allow create: if isAdmin() &&
        isValidId(dishId) &&
        isValidChristmasDish(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(dishId) &&
        isValidChristmasDish(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'category', 'foodType', 'priceInrPerGuest',
          'portion', 'description', 'image', 'popular', 'presets', 'active',
          'sortOrder', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(dishId);
    }

    // --- Collection: /users/{userId} (Private PII & Saved Shortlist) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isAuthenticatedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAuthenticatedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'savedVendorIds', 'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'savedVendorIds', 'updatedAt'
            ])
          )
        );

      allow delete: if isAuthenticatedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // --- Collection: /bookings/{bookingId} (Private Customer <-> Vendor Enquiries) ---
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isAuthenticatedUser() && (
        existing().customerId == request.auth.uid ||
        existing().vendorOwnerId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isRootAdminToken() || (isAuthenticatedUser() && (
        existing().customerId == request.auth.uid ||
        existing().vendorOwnerId == request.auth.uid
      ));

      allow create: if isAuthenticatedUser() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().customerId == request.auth.uid &&
        incoming().status in ['Confirmed Enquiry', 'Awaiting Vendor Reply'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAuthenticatedUser() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().customerId == existing().customerId &&
        incoming().vendorId == existing().vendorId &&
        incoming().vendorOwnerId == existing().vendorOwnerId &&
        incoming().reference == existing().reference &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Customer cancels non-terminal enquiry
          (
            existing().customerId == request.auth.uid &&
            !(existing().status in ['Completed', 'Cancelled']) &&
            incoming().status == 'Cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          // Action 2: Vendor owner updates non-terminal enquiry status
          (
            existing().vendorOwnerId == request.auth.uid &&
            !(existing().status in ['Completed', 'Cancelled']) &&
            incoming().status in ['Confirmed Enquiry', 'Completed', 'Cancelled'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          // Action 3: Admin override
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
          )
        );

      allow delete: if isAuthenticatedUser() &&
        isValidId(bookingId) &&
        (existing().customerId == request.auth.uid || isAdmin());
    }

    // --- Collection: /reviews/{reviewId} (Public Verified Customer Reviews) ---
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if isRootAdminToken() || (request.query.limit != null && request.query.limit <= 100);

      allow create: if isAuthenticatedUser() &&
        isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isAuthenticatedUser() &&
        isValidId(reviewId) &&
        (existing().authorId == request.auth.uid || isAdmin());
    }

    // --- Collection: /eventRequests/{requestId} (Broadcast Event Leads — No PII) ---
    match /eventRequests/{requestId} {
      allow get: if isValidId(requestId) && isAuthenticatedUser() && (
        existing().status == 'open' ||
        existing().customerId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isRootAdminToken() || (isAuthenticatedUser() && (
        existing().status == 'open' ||
        existing().customerId == request.auth.uid
      ));

      allow create: if isAuthenticatedUser() &&
        isValidId(requestId) &&
        isValidEventRequest(incoming()) &&
        incoming().customerId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAuthenticatedUser() &&
        isValidId(requestId) &&
        isValidEventRequest(incoming()) &&
        incoming().customerId == existing().customerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Customer closes an open request (closed is terminal)
          (
            existing().customerId == request.auth.uid &&
            existing().status == 'open' &&
            incoming().status == 'closed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          // Action 2: Admin override
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isAuthenticatedUser() &&
        isValidId(requestId) &&
        (existing().customerId == request.auth.uid || isAdmin());

      // --- Subcollection: /eventRequests/{requestId}/quotes/{quoteId} (Master Gate) ---
      match /quotes/{quoteId} {
        allow get: if isValidId(requestId) && isValidId(quoteId) && isAuthenticatedUser() && (
          existing().vendorOwnerId == request.auth.uid ||
          existing().requestCustomerId == request.auth.uid ||
          get(/databases/$(database)/documents/eventRequests/$(requestId)).data.customerId == request.auth.uid ||
          isAdmin()
        );

        allow list: if isAuthenticatedUser() && (
          existing().vendorOwnerId == request.auth.uid ||
          existing().requestCustomerId == request.auth.uid
        );

        allow create: if isAuthenticatedUser() &&
          isValidId(requestId) &&
          isValidId(quoteId) &&
          isValidEventQuote(incoming(), requestId) &&
          incoming().vendorOwnerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/eventRequests/$(requestId)) &&
          get(/databases/$(database)/documents/eventRequests/$(requestId)).data.status == 'open' &&
          get(/databases/$(database)/documents/eventRequests/$(requestId)).data.customerId == incoming().requestCustomerId;

        allow update: if false;

        allow delete: if isAuthenticatedUser() &&
          isValidId(requestId) &&
          isValidId(quoteId) &&
          (existing().vendorOwnerId == request.auth.uid || isAdmin());
      }
    }

    // --- Collection: /vendorMetrics/{vendorId} (Cloud Engagement Analytics) ---
    match /vendorMetrics/{vendorId} {
      allow get: if isValidId(vendorId);
      allow list: if isRootAdminToken();

      allow create: if isAuthenticatedUser() &&
        isValidId(vendorId) &&
        isValidVendorMetric(incoming(), vendorId) &&
        incoming().views <= 1 &&
        incoming().whatsappClicks <= 1 &&
        incoming().shares <= 1 &&
        incoming().updatedAt == request.time;

      allow update: if isAuthenticatedUser() &&
        isValidId(vendorId) &&
        isValidVendorMetric(incoming(), vendorId) &&
        incoming().vendorId == existing().vendorId &&
        incoming().updatedAt == request.time && (
          // Action 1: Strictly monotonic +0/+1 engagement increment
          (
            incoming().views >= existing().views &&
            incoming().views <= existing().views + 1 &&
            incoming().whatsappClicks >= existing().whatsappClicks &&
            incoming().whatsappClicks <= existing().whatsappClicks + 1 &&
            incoming().shares >= existing().shares &&
            incoming().shares <= existing().shares + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'views', 'whatsappClicks', 'shares', 'updatedAt'
            ])
          ) ||
          // Action 2: Admin correction
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'views', 'whatsappClicks', 'shares', 'updatedAt'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(vendorId);
    }

    // --- Collection: /admins/{adminId} ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if false;
      allow create: if isAdmin() && isValidId(adminId) && isValidAdminRecord(incoming(), adminId) && incoming().grantedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminId);
    }
  }
}
