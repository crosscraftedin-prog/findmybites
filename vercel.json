{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon-32x32\\.png|apple-touch-icon\\.png|icons/.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/db/:path*",
      "destination": "/api/db?path=:path*"
    },
    {
      "source": "/@:handle",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(googlebot|bingbot|yandex|baiduspider|duckduckbot|slurp|facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|pinterest|applebot|embedly|quora|outbrain|rogerbot).*"
        }
      ],
      "destination": "/api/seo?path=/@:handle"
    },
    {
      "source": "/:prefix(v|fmb|city|category)/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(googlebot|bingbot|yandex|baiduspider|duckduckbot|slurp|facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|pinterest|applebot|embedly|quora|outbrain|rogerbot).*"
        }
      ],
      "destination": "/api/seo?path=/:prefix/:slug"
    },
    {
      "source": "/:city/:category",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(googlebot|bingbot|yandex|baiduspider|duckduckbot|slurp|facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|pinterest|applebot|embedly|quora|outbrain|rogerbot).*"
        }
      ],
      "destination": "/api/seo?path=/:city/:category"
    },
    {
      "source": "/((?!api/|assets/|icons/|sw\\.js|manifest\\.webmanifest|robots\\.txt|sitemap\\.xml|favicon\\.ico|favicon-32x32\\.png|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
