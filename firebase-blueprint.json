  "firestore": {
    "/vendors/{vendorId}": {
      "schema": { "$ref": "#/entities/Vendor" },
      "description": "Published vendor storefronts readable publicly when status is active; writable by authenticated owner, admin, or atomically transferred via valid StoreClaim."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profiles and shortlisted vendor IDs; isolated to document owner and admin."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/BookingEnquiry" },
      "description": "Customer booking enquiries accessible strictly to the customer, the target vendor owner, or an admin."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Public vendor reviews created by verified users; immutable after creation and deletable only by author or admin."
    },
    "/eventRequests/{requestId}": {
      "schema": { "$ref": "#/entities/EventRequest" },
      "description": "Broadcast customer event requests (no PII); open requests readable by authenticated users, editable only by request owner or admin."
    },
    "/eventRequests/{requestId}/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/EventQuote" },
      "description": "Vendor quotes submitted against a parent event request; readable by the request customer, the quoting vendor, or admin."
    },
    "/vendorMetrics/{vendorId}": {
      "schema": { "$ref": "#/entities/VendorMetric" },
      "description": "Storefront views, WhatsApp clicks, and share counters; strictly monotonic increments (+0 or +1) by authenticated users."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin directory managed strictly by existing admins."
    },
    "/storeClaims/{claimId}": {
      "schema": { "$ref": "#/entities/StoreClaim" },
      "description": "Cryptographically keyed store handover tickets (SHA-256 of phone + passcode); non-enumerable by public, atomic single-use redemption."
    },
    "/adminTransfers/{vendorId}": {
      "schema": { "$ref": "#/entities/AdminTransferRecord" },
      "description": "Admin-only private transfer log containing target phone and handover passcode for WhatsApp dispatch."
    },
    "/siteSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Publicly readable global SEO and campaign settings, writable strictly by verified admins."
    },
    "/christmasDishes/{dishId}": {
      "schema": { "$ref": "#/entities/ChristmasDish" },
      "description": "Publicly readable Hyderabad Christmas Dinner & Lunch custom menu dishes, writable strictly by verified admins."
    }
  }
}
