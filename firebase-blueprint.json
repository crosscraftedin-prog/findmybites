{
  "entities": {
    "Vendor": {
      "title": "Vendor",
      "description": "A published food artisan or event professional storefront on FindMyBites x PimpMyParty.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the vendor account owner."
        },
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "URL-safe storefront slug for findmybites.com/v/<slug>."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Business display name."
        },
        "marketplace": {
          "type": "string",
          "enum": ["food", "party"],
          "description": "Marketplace ecosystem: food (FindMyBites) or party (PimpMyParty)."
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Primary vendor service category."
        },
        "country": {
          "type": "string",
          "enum": ["India", "Dubai / UAE", "Sri Lanka", "Pakistan", "Bangladesh", "Nepal"],
          "description": "Phase 1 launch country."
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "State, emirate, province, or division."
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "City name."
        },
        "area": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Neighborhood or locality."
        },
        "lat": {
          "type": "number",
          "description": "Approximate latitude for Near Me sorting."
        },
        "lng": {
          "type": "number",
          "description": "Approximate longitude for Near Me sorting."
        },
        "whatsappNumber": {
          "type": "string",
          "minLength": 7,
          "maxLength": 18,
          "pattern": "^[0-9]+$",
          "description": "Public business WhatsApp hotline digits with country code."
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "business"],
          "description": "SaaS listing tier (paid tiers rank above free)."
        },
        "monthlyAutoPay": {
          "type": "boolean",
          "description": "Whether monthly auto-pay subscription is active."
        },
        "priceTier": {
          "type": "string",
          "enum": ["$", "$$", "$$$", "$$$$"],
          "description": "Relative price band."
        },
        "startingPriceUsd": {
          "type": "number",
          "description": "Base package price in USD equivalent."
        },
        "rating": {
          "type": "number",
          "description": "Average customer rating."
        },
        "reviewCount": {
          "type": "number",
          "description": "Total verified review count."
        },
        "responseTime": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Typical WhatsApp response SLA."
        },
        "verified": {
          "type": "boolean",
          "description": "Admin-verified partner badge."
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending_review", "paused"],
          "description": "Storefront visibility & moderation state."
        },
        "tagline": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "description": "Short storefront headline."
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1200,
          "description": "Full storefront description."
        },
        "promoBanner": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional seasonal or festival offer banner shown on the storefront."
        },
        "christmasSpecial": {
          "type": "boolean",
          "description": "Whether the storefront is highlighted in the Christmas & New Year 2026 Spotlight section."
        },
        "christmasOffer": {
          "type": "string",
          "maxLength": 140,
          "description": "Optional Christmas & New Year menu highlight (e.g. Plum Cakes, Yule Logs, NYE Hampers)."
        },
        "bioHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "Optional short link-in-bio handle for findmybites.com/fmb/<handle> and findmybites.com/@<handle>."
        },
        "bioTheme": {
          "type": "string",
          "enum": ["saffron", "midnight", "party", "cream"],
          "description": "Visual theme preset for the vendor's Link-in-Bio page."
        },
        "instagramHandle": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional Instagram handle or profile URL displayed on the bio-link page."
        },
        "customLinks": {
          "type": "array",
          "description": "Up to 8 custom external bio links (Swiggy, Zomato, Talabat, Google Reviews, YouTube, Menu PDF, Website)."
        },
        "serviceAreas": {
          "type": "array",
          "description": "Up to 10 covered local areas."
        },
        "allStatesCoverage": {
          "type": "boolean",
          "description": "Admin-controlled flag allowing this storefront to appear across all states in its country (e.g., Pan-India)."
        },
        "serviceStates": {
          "type": "array",
          "description": "Admin-controlled list of up to 40 states/regions where this storefront is visible and accepts orders."
        },
        "specialties": {
          "type": "array",
          "description": "Up to 10 specialties."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150000,
          "description": "Hero cover image URL, asset path, or compressed data URL."
        },
        "logo": {
          "type": "string",
          "maxLength": 70000,
          "description": "Optional business logo image URL or compressed data URL."
        },
        "gallery": {
          "type": "array",
          "description": "Optional portfolio gallery of up to 6 compressed photo data URLs or asset paths."
        },
        "products": {
          "type": "array",
          "description": "Up to 20 catalog products/packages displayed on the vendor mini-website."
        },
        "claimStatus": {
          "type": "string",
          "enum": ["none", "pending", "claimed"],
          "description": "Concierge store handover state: none (self-created), pending (awaiting baker claim), or claimed (ownership transferred)."
        },
        "claimedByToken": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 claim receipt ID recorded only after successful atomic transfer (never stored while pending)."
        },
        "seoTitle": {
          "type": "string",
          "maxLength": 100,
          "description": "Custom Google SEO title override for this storefront."
        },
        "seoDescription": {
          "type": "string",
          "maxLength": 220,
          "description": "Custom Google SEO meta description override for this storefront."
        },
        "seoKeywords": {
          "type": "string",
          "maxLength": 240,
          "description": "Comma-separated target local search keywords for this storefront."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "ownerId",
        "slug",
        "name",
        "marketplace",
        "category",
        "country",
        "state",
        "city",
        "area",
        "lat",
        "lng",
        "whatsappNumber",
        "planTier",
        "monthlyAutoPay",
        "priceTier",
        "startingPriceUsd",
        "rating",
        "reviewCount",
        "responseTime",
        "verified",
        "status",
        "tagline",
        "description",
        "serviceAreas",
        "specialties",
        "image",
        "products",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile containing saved vendor IDs and contact details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified account email (private PII)."
        },
        "savedVendorIds": {
          "type": "array",
          "description": "Up to 50 shortlisted vendor IDs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "savedVendorIds", "createdAt", "updatedAt"]
    },
    "BookingEnquiry": {
      "title": "BookingEnquiry",
      "description": "Customer booking enquiry sent to a vendor storefront.",
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Human-readable booking reference code."
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the customer."
        },
        "vendorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target vendor identifier."
        },
        "vendorOwnerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the vendor owner or platform."
        },
        "vendorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Vendor business name."
        },
        "vendorCity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Vendor city and country."
        },
        "vendorCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Vendor category."
        },
        "packageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Selected product or order basket summary."
        },
        "estimatedUsd": {
          "type": "number",
          "description": "Estimated booking value in USD equivalent."
        },
        "eventDate": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30,
          "description": "Requested event date."
        },
        "guests": {
          "type": "number",
          "description": "Expected guest count."
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Customer name (private to customer & vendor owner)."
        },
        "customerEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Customer email or phone (private to customer & vendor owner)."
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Event details and customization notes."
        },
        "status": {
          "type": "string",
          "enum": ["Confirmed Enquiry", "Awaiting Vendor Reply", "Completed", "Cancelled"],
          "description": "Enquiry lifecycle state (Completed and Cancelled are terminal)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "reference",
        "customerId",
        "vendorId",
        "vendorOwnerId",
        "vendorName",
        "vendorCity",
        "vendorCategory",
        "packageName",
        "estimatedUsd",
        "eventDate",
        "guests",
        "customerName",
        "customerEmail",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "Public customer review and star rating for a vendor storefront (contains no private PII).",
      "type": "object",
      "properties": {
        "vendorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target vendor ID."
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the reviewer."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Public reviewer display name."
        },
        "eventType": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Occasion booked (e.g. Wedding, Birthday, Corporate)."
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5."
        },
        "comment": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600,
          "description": "Customer review text."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["vendorId", "authorId", "authorName", "eventType", "rating", "comment", "createdAt"]
    },
    "EventRequest": {
      "title": "EventRequest",
      "description": "Customer event brief broadcast to local vendors (contains no customer PII).",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the requesting customer."
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Customer first name or display label."
        },
        "occasion": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Event type such as Birthday, Wedding, Corporate."
        },
        "categories": {
          "type": "array",
          "description": "1 to 4 requested service categories."
        },
        "country": {
          "type": "string",
          "enum": ["India", "Dubai / UAE", "Sri Lanka", "Pakistan", "Bangladesh", "Nepal"],
          "description": "Event country."
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Event state, emirate, or province."
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Event city."
        },
        "eventDate": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30,
          "description": "Event date."
        },
        "guests": {
          "type": "number",
          "description": "Expected guest count."
        },
        "budgetUsd": {
          "type": "number",
          "description": "Target budget in USD equivalent."
        },
        "details": {
          "type": "string",
          "minLength": 5,
          "maxLength": 800,
          "description": "Event requirements, theme, or dietary notes."
        },
        "status": {
          "type": "string",
          "enum": ["open", "closed"],
          "description": "Request status (closed is terminal)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "customerId",
        "customerName",
        "occasion",
        "categories",
        "country",
        "state",
        "city",
        "eventDate",
        "guests",
        "budgetUsd",
        "details",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "EventQuote": {
      "title": "EventQuote",
      "description": "Vendor quote submitted in response to an open EventRequest.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent event request ID."
        },
        "requestCustomerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the parent event request customer (verified against parent on create)."
        },
        "vendorOwnerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the quoting vendor."
        },
        "vendorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Vendor storefront ID."
        },
        "vendorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Vendor business name."
        },
        "vendorSlug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "Vendor storefront slug."
        },
        "vendorWhatsapp": {
          "type": "string",
          "minLength": 7,
          "maxLength": 18,
          "pattern": "^[0-9]+$",
          "description": "Public vendor business WhatsApp number."
        },
        "priceUsd": {
          "type": "number",
          "description": "Quoted estimate in USD equivalent."
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600,
          "description": "Quote details and package inclusions."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "requestId",
        "requestCustomerId",
        "vendorOwnerId",
        "vendorId",
        "vendorName",
        "vendorSlug",
        "vendorWhatsapp",
        "priceUsd",
        "message",
        "createdAt"
      ]
    },
    "VendorMetric": {
      "title": "VendorMetric",
      "description": "Aggregated cloud engagement metrics for a vendor storefront.",
      "type": "object",
      "properties": {
        "vendorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target vendor ID."
        },
        "views": {
          "type": "number",
          "description": "Total storefront views."
        },
        "whatsappClicks": {
          "type": "number",
          "description": "Total WhatsApp inquiry clicks."
        },
        "shares": {
          "type": "number",
          "description": "Total QR poster or story card downloads/shares."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["vendorId", "views", "whatsappClicks", "shares", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin role document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedAt"]
    },
    "StoreClaim": {
      "title": "StoreClaim",
      "description": "Cryptographically addressed store handover ticket keyed by SHA-256(phone + passcode). Contains no raw phone number or passcode.",
      "type": "object",
      "properties": {
        "vendorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target vendor document ID."
        },
        "vendorSlug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "Target vendor storefront slug."
        },
        "vendorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Public storefront display name."
        },
        "phoneLast4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$",
          "description": "Last 4 digits of target phone for baker confirmation without exposing PII."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "claimed", "revoked"],
          "description": "Transfer lifecycle state (claimed and revoked are terminal)."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin UID who issued this claim ticket."
        },
        "claimedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Vendor UID who redeemed the claim ticket."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["vendorId", "vendorSlug", "vendorName", "phoneLast4", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "AdminTransferRecord": {
      "title": "AdminTransferRecord",
      "description": "Admin-only private concierge transfer log storing target phone number and handover passcode for WhatsApp sharing.",
      "type": "object",
      "properties": {
        "vendorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "vendorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "vendorSlug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "targetPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 18,
          "pattern": "^[0-9]+$"
        },
        "passcode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "claimId": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "claimed", "revoked"]
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["vendorId", "vendorName", "vendorSlug", "targetPhone", "passcode", "claimId", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global SEO metadata, campaign announcement banner, snowfall toggle, and vendor approval gate settings controlled by Admin.",
      "type": "object",
      "properties": {
        "siteTitle": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100
        },
        "siteDescription": {
